{
  "DatabaseOptions": {
    "ConnectionString": "Data Source=../../data/banco.db;Mode=ReadWrite;Foreign Keys=True",
    "ExpectedSchemaVersion": 1
  },
  "BcraOptions": {
    "BaseAddress": "https://api.bcra.gob.ar/",
    "DeudasPath": "CentralDeDeudores/v1.0/Deudas/{0}",
    "TimeoutSeconds": 5,
    "TotalTimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryBaseDelayMs": 200,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30,
    "CircuitBreakerSamplingSeconds": 60,
    "LogResponseBody": true
  },
  "CacheOptions": {
    "BcraExpirationSeconds": 3600,
    "BcraNotFoundExpirationSeconds": 600,
    "BcraStaleRetentionSeconds": 86400,
    "SizeLimit": 10000
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Fatal"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/banco-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
